# Build machines for tools/release (example). Copy to tools/release/release.local.env and fill in your own values.
# The .local file is never exported. Environment variables with the same names win over the file.

# Theos machine for the deb (build_deb.py). Leave ENCORE_DEB_SSH empty to build on this machine with $THEOS.
ENCORE_DEB_SSH=builder@192.0.2.20
ENCORE_DEB_SSH_KEY=~/.ssh/encore_build_key
ENCORE_DEB_THEOS=~/theos

# Scratch Linux machine with Docker for the smoke build (docker_smoke.py). Never a server that runs your live bridge.
ENCORE_DOCKER_SSH=
ENCORE_DOCKER_SSH_KEY=
ENCORE_DOCKER_DIR=encore-release-smoke
ENCORE_DOCKER_SUDO=0

# Linux x86-64 machine with Docker for the Windows bundle (build_windows.py runs gateway/windows/build.sh there in its
# own build images). Leave ENCORE_WIN_SSH empty to build on this machine (needs bash and Docker).
ENCORE_WIN_SSH=
ENCORE_WIN_SSH_KEY=
ENCORE_WIN_DIR=encore-release-win
# optional: keep the pinned Node.js and FFmpeg downloads here between runs
ENCORE_WIN_CACHE=
ENCORE_WIN_SUDO=0

# The private Ed25519 release-signing key: release.py --final signs SHA256SUMS.txt with it (SHA256SUMS.txt.sig) and
# every scan checks that none of its material is anywhere. Make it once, outside the working copy, in a folder named
# _keys (never exported, never copied anywhere, owner-only):
#   python tools/release/signkey.py generate --key <folder>/_keys/encore-release-ed25519.key
# --sign-key on the command line wins over this setting.
ENCORE_SIGN_KEY=

# ssh and scp programs, if not the ones on PATH
# ENCORE_SSH_BIN=ssh
# ENCORE_SCP_BIN=scp
