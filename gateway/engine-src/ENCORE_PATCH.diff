+// A listing says which revision of the playlist it was read at, when, and
+// whether it stopped at max_tracks, so a client can tell whether it is still
+// current and complete. None of that is known before it is ready.
+func TestContextTracksListingMetadata(t *testing.T) {
+	const playlist = "spotify:playlist:0hgSZmY9xhzx51hlLB2arI"
+
+	resolver := playlistResolver(t, map[string]string{"playlist.revision": "0000002a8f3c"}, trackUri(0x01), trackUri(0x02), trackUri(0x03))
+	p := newMetaTestPlayer(t, echoMetadata, resolveTo(resolver))
+	p.app.cfg.Metadata.MaxTracks = 2
+	fetched := time.UnixMilli(1790340000000)
+	p.app.contextLists.now = func() time.Time { return fetched }
+
+	resp := listContext(t, p, ApiRequestDataContextTracks{Uri: playlist})
+	require.False(t, resp.Ready)
