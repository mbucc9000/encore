+			return respond(req, http.StatusOK, `{"session_id":"sid"}`), nil
+		}
+
+		session, err := f.sp.SocialCurrent(context.Background())
+		require.NoError(t, err)
+		require.JSONEq(t, `{"session_id":"sid"}`, string(session))
+		require.Len(t, f.transport.sent(), 2)
+	})
+}
