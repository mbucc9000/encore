+	require.Len(t, events, 2)
+	require.Equal(t, ApiEventDataCluster{Active: "other", JamContext: true}, events[1])
+
+	lastCluster, lastInactive := -1, -1
+	for i, typ := range apiEvents(p) {
+		switch typ {
+		case ApiEventTypeCluster:
+			lastCluster = i
+		case ApiEventTypeInactive:
+			lastInactive = i
+		}
+	}
