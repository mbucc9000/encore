+	started := make(chan struct{})
+	release := make(chan struct{})
+	l.submit(loaderJob{
+		name:        "prefetch a",
+		class:       classPrefetch,
+		gen:         4,
+		opensStream: true,
+		run: func(ctx context.Context) loaderResult {
+			close(started)
+			select {
+			case <-release:
+				return loaderResult{}
+			case <-ctx.Done():
+				return loaderResult{err: ctx.Err()}
+			}
+		},
+	})
+	<-started
+
+	step := idleJob("advance", classNav, noReply)
+	step.keepPrefetch, step.prefetchGen = true, 4
