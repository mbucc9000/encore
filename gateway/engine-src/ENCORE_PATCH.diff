+	require.Eventually(t, func() bool {
+		resp := listContext(t, p, ApiRequestDataContextTracks{Uri: playlist, Summary: true})
+		return resp.Ready && resp.Cached == resp.Length
+	}, 2*time.Second, 10*time.Millisecond)
+
+	summary := listContext(t, p, ApiRequestDataContextTracks{Uri: playlist, Summary: true})
+	require.Nil(t, summary.Tracks)
+	require.Equal(t, 5, summary.Length)
+	require.Equal(t, 5, summary.Cached)
+	require.Zero(t, summary.Failed)
+	raw, err := json.Marshal(summary)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), `"tracks"`, "a summary leaves the entries out")
+
+	window := func(from int, limit *int) []string {
+		resp := listContext(t, p, ApiRequestDataContextTracks{Uri: playlist, From: from, Limit: limit})
+		require.Equal(t, 5, resp.Length)
+		require.Equal(t, 5, resp.Cached, "the counts describe the whole listing")
+		require.NotNil(t, resp.Tracks)
+
+		uris := []string{}
+		for _, entry := range *resp.Tracks {
+			require.NotNil(t, entry.Track)
