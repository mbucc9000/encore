+
+	poll := func() (*ApiContextTracks, error) {
+		data, err := p.handleApiRequest(ApiRequest{Type: ApiRequestTypeContextTracks, Data: ApiRequestDataContextTracks{Uri: playlist, Summary: true}})
+		if err != nil {
+			return nil, err
+		}
+		return data.(*ApiContextTracks), nil
+	}
+	held := func() bool {
+		_, err := poll()
+		return err != nil
+	}
+
+	for _, n := range []int32{1, 2} {
+		require.Eventually(t, held, 2*time.Second, 10*time.Millisecond, "enumeration %d fails", n)
+		for range 20 {
+			_, err := poll()
+			require.Error(t, err, "a held context answers with the failure")
+			require.NotErrorIs(t, err, ErrNotFound, "which is not the metadata cache being off")
+			require.NotErrorIs(t, err, ErrBadRequest, "nor a uri that names no context")
+		}
+		require.EqualValues(t, n, resolved.Load(), "the polls started nothing")
+
+		clock.advance(contextListHold - time.Second)
+		require.True(t, held())
+		clock.advance(time.Second)
+		resp, err := poll()
+		require.NoError(t, err, "the hold runs out")
+		require.False(t, resp.Ready, "and the next poll enumerates again")
+	}
+
+	require.Eventually(t, func() bool {
+		resp, err := poll()
+		return err == nil && resp.Ready
+	}, 2*time.Second, 10*time.Millisecond)
+	require.EqualValues(t, 3, resolved.Load())
+}
+
+// A player that closes during an enumeration (a session swap) cancels it, and
+// that is no refusal: the context is not held.
+func TestContextTracksDoesNotHoldACancelledEnumeration(t *testing.T) {
+	const playlist = "spotify:playlist:0hgSZmY9xhzx51hlLB2arI"
+
+	started := make(chan struct{})
+	p := newMetaTestPlayer(t, echoMetadata, func(ctx context.Context, _ string) (tracks.ContextResolver, error) {
+		close(started)
+		<-ctx.Done()
+		return nil, ctx.Err()
+	})
+	ctx, cancel := context.WithCancel(t.Context())
+	p.ctx = ctx
+
+	require.False(t, listContext(t, p, ApiRequestDataContextTracks{Uri: playlist, Summary: true}).Ready)
+	<-started
+	cancel()
+
+	// A hold is recorded before the enumeration lets go of the context, so
+	// one that can be claimed again is not held.
+	require.Eventually(t, func() bool { return claimed(p.app.contextLists, playlist) }, 2*time.Second, 10*time.Millisecond)
+	require.False(t, p.app.contextLists.held(playlist))
+}
