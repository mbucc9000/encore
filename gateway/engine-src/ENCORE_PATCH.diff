+	for _, want := range []string{"prefetch a", "advance"} {
+		select {
+		case res := <-l.results:
+			require.Equal(t, want, res.name)
+			require.NoError(t, res.err)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("%s never came back", want)
+		}
+	}
+}
