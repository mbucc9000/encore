+// (synthetic values, the capture's lengths).
+const (
+	radarToken = "Rad4rT0kenAbCdEfGhIj"
+	linkToken  = "L1nkT0kenAbCdEfGhIjKlM"
+	otherDev   = "fedcba9876543210fedcba9876543210fedcba98"
