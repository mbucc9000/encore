+// An entry the backend had nothing for is left out of the fetches for an hour,
+// then asked for again. Metadata that arrives another way ends that at once.
+func TestTrackMetaCacheFailuresExpire(t *testing.T) {
+	c := newTrackMetaCache(trackMetaCacheLimit)
+	now := time.Now()
+	c.now = func() time.Time { return now }
+
+	c.markFailed(trackUri(0x01), metaFailureTTL)
+	c.markFailed(trackUri(0x02), metaFailureTTL)
+	c.markFailed(trackUri(0x04), metaTransientFailureTTL)
+	uris := []string{trackUri(0x01), trackUri(0x02), trackUri(0x03), trackUri(0x04)}
+	require.Equal(t, []string{trackUri(0x03)}, c.missing(uris))
+
+	c.put(trackUri(0x02), mediaFixture("two"))
+	require.False(t, c.isFailed(trackUri(0x02)), "a put forgets the failure")
+
+	c.markFailed(trackUri(0x02), metaFailureTTL)
+	require.False(t, c.isFailed(trackUri(0x02)), "a cached entry is never marked")
+
+	now = now.Add(metaTransientFailureTTL + time.Second)
+	require.False(t, c.isFailed(trackUri(0x04)), "a mark for a passing fault runs out sooner")
+	require.True(t, c.isFailed(trackUri(0x01)))
+
+	now = now.Add(metaFailureTTL - metaTransientFailureTTL - time.Second)
+	require.True(t, c.isFailed(trackUri(0x01)), "a failure exactly as old as the TTL still holds")
+
+	now = now.Add(time.Second)
+	require.False(t, c.isFailed(trackUri(0x01)))
+	require.Equal(t, []string{trackUri(0x01), trackUri(0x03), trackUri(0x04)}, c.missing(uris), "an expired failure is fetched again")
