+			resp := ts.do(http.MethodPost, "/player/queue/remove", `{"rev":"r","uid":"q1"}`)
+			require.Equal(t, tt.want, resp.StatusCode)
+			require.Empty(t, resp.Header.Get("X-Upstream-Status"))
+		})
+	}
+}
