+		require.Equal(t, "Bearer fresh-token", sent[1].header.Get("Authorization"))
+		require.GreaterOrEqual(t, sent[1].at.Sub(sent[0].at), socialSendSpacing, "the resend is spaced too")
+
+		stats := f.gate.Stats()
