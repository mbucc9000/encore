+	p := newShuffleTestPlayer(t)
+	spotCtx, _ := shuffleTestContext(playlistUri, 0x01, 3)
+	p.resolvePlayContext = func(context.Context, string) (*connectpb.Context, error) { return spotCtx, nil }
