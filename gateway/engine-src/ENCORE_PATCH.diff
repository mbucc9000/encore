+	resp = listContext(t, p, ApiRequestDataContextTracks{Uri: playlist})
+	require.Equal(t, 2, resp.Length)
+	require.Equal(t, "0000002a8f3c", resp.Revision)
+	require.Equal(t, fetched.UnixMilli(), resp.FetchedAt)
+	require.True(t, resp.Truncated, "the enumeration stopped at max_tracks")
