+		}
+		return uris
+	}
+	require.Equal(t, want, window(0, nil))
+	require.Equal(t, want[1:3], window(1, pointer(2)))
+	require.Equal(t, want[3:], window(3, nil))
+	require.Equal(t, want[4:], window(4, pointer(10)), "a limit past the end stops there")
+	require.Empty(t, window(0, pointer(0)))
+	require.Empty(t, window(5, nil))
+	require.Empty(t, window(9, pointer(1)), "from past the end")
+
+	from, to := listingWindow(5, 2, pointer(math.MaxInt))
+	require.Equal(t, []int{2, 5}, []int{from, to}, "a huge limit must not overflow")
