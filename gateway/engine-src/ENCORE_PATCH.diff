+		f := newSocialFixture(t)
+		ctx := context.Background()
+
+		for _, bad := range []string{"", "a/b", "..", "a%2Fb", "a b", "x?y=1", strings.Repeat("a", 129)} {
+			_, err := f.sp.SocialInfo(ctx, bad)
