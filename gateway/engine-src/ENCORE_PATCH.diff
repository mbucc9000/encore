+// emitted returns the data of the events of one type, in the order emitted.
+func emitted(p *AppPlayer, typ ApiEventType) []any {
+	var out []any
+	for _, ev := range p.app.server.(*recordingApiServer).emitted {
+		if ev.Type == typ {
+			out = append(out, ev.Data)
+		}
+	}
+	return out
+}
