+// A sweep the backend refused is not sent back to it by the next poll: the
+// context is held for metaSweepHold, then swept again. Meanwhile the listing
+// still reports a sweep to come, so a client does not take the entries
+// without metadata for ones that will never get any.
+func TestMetaSweepHoldsAContextThatFailed(t *testing.T) {
+	const playlist = "spotify:playlist:0hgSZmY9xhzx51hlLB2arI"
+
+	fetch, calls := recordingFetch(func(context.Context, *extmetadatapb.BatchedEntityRequest) (*extmetadatapb.BatchedExtensionResponse, error) {
+		return nil, errors.New("boom")
+	})
+	p := newMetaTestPlayer(t, fetch, resolveTo(playlistResolver(t, map[string]string{}, trackUri(0x01), trackUri(0x02))))
+	clock := &manualClock{at: time.Now()}
+	p.meta.now = clock.now
+
+	poll := func() *ApiContextTracks {
+		return listContext(t, p, ApiRequestDataContextTracks{Uri: playlist, Summary: true})
+	}
+	require.Eventually(t, func() bool {
+		return poll().Ready && len(calls()) == 1 && p.meta.onHold(playlist) && !p.meta.sweeps.sweeping(playlist)
+	}, 2*time.Second, 10*time.Millisecond)
+
+	// A job that ran meanwhile would have fetched, so a count that stays at
+	// one means nothing was sent.
+	for range 5 {
+		resp := poll()
+		require.True(t, resp.Sweeping, "a held context still has a sweep to come")
+		require.Equal(t, 2, resp.Length-resp.Cached-resp.Failed)
+	}
+	clock.advance(metaSweepHold - time.Second)
+	require.True(t, poll().Sweeping)
+	require.Len(t, calls(), 1)
+	require.Zero(t, poll().Failed, "a request that failed as a whole marks no entry")
+
+	clock.advance(time.Second)
+	require.Eventually(t, func() bool {
+		poll()
+		return len(calls()) == 2
+	}, 2*time.Second, 10*time.Millisecond, "the hold runs out")
+}
