+	}
+	return out
+}
+
+func commandEventsOf(p *AppPlayer) []ApiEventDataCommand {
+	var out []ApiEventDataCommand
+	for _, data := range emitted(p, ApiEventTypeCommand) {
+		out = append(out, data.(ApiEventDataCommand))
+	}
+	return out
+}
