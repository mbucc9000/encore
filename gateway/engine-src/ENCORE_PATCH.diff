+	require.NoError(t, err)
+	require.Equal(t, "q3", data.(*ApiQueueTopResult).Uid)
+	require.Equal(t, nextLayout(p.state.player.NextTracks), listLayout(t, p), "what is published is what plays")
+
+	p.setOptions(nil, nil, pointer(false))
+	runQueuedJob(t, p)
+
